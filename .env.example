# ─── Database ─────────────────────────────────────────────────────────────────
# For Supabase: use the pooled connection URL (port 6543) with ?pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/kinguard

# Direct (non-pooled) URL — Prisma CLI uses this for migrations.
# For local PostgreSQL: same as DATABASE_URL.
# For Supabase: use the direct connection URL (port 5432).
DIRECT_URL=postgresql://user:password@localhost:5432/kinguard

# ─── JWT ──────────────────────────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-this-with-a-strong-random-secret-min-32-chars

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin — no trailing slash. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ─── Email notifications (Brevo) ──────────────────────────────────────────────
# The system uses the Brevo REST API for email (not SMTP) because hosting
# platforms like Render block outbound SMTP ports. Leave blank to disable.
#
# Get a free API key at https://app.brevo.com — 300 emails/day on the free plan.
# SMTP_FROM is the sender name and address shown in outgoing emails.
BREVO_API_KEY=
SMTP_FROM=KinMarché <noreply@kinmarche.com>

# ─── Admin email fallback ──────────────────────────────────────────────────────
# If no admin in the database has an email address set, submission notifications
# are sent to this address instead.
ADMIN_EMAIL=
